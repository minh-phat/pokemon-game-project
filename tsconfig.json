{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/backend/**/*.ts",
    "apps/game-server/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "apps/frontend"]
}
